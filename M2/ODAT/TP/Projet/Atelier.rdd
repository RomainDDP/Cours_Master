<Symbol symbolId="SYMB6" type="sdlText" xCenter="506" yCenter="275" fixedDimensions="FALSE" width="352" height="440" color="#000000" fillColor="#FFFFFF">
<Description></Description>
<Text>/* Environnement -&gt; Network -&gt; Superviseur */
SIGNAL NewPiece (MachineId);

/* Capteurs */
SIGNAL Sensor_PlaceDone;
SIGNAL Sensor_MachinePickDone (MachineId);
SIGNAL Sensor_MachineDropDone (MachineId);
SIGNAL Sensor_RemoveDone;

/* Robot d’alimentation */
SIGNAL Cmd_Place     (MachineId);
SIGNAL Ack_PlaceDone;

/* Machines */
SIGNAL Cmd_Prepare;
SIGNAL Ack_Picked       (MachineId);
SIGNAL Rpt_EndMachining (MachineId);
SIGNAL Cmd_DropToConv;
SIGNAL Ack_Dropped      (MachineId);

/* Robot de retrait */
SIGNAL Cmd_Remove;
SIGNAL Ack_RemoveDone;

/* Supervision */
SIGNAL Cmd_StopAll;
</Text>
</Symbol>

