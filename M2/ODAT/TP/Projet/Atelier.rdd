<Symbol symbolId="SYMB1" type="sdlSysDgmFrm" xCenter="708" yCenter="420" fixedDimensions="TRUE" width="1373" height="775" color="-" fillColor="-">
<Description></Description>
<Text></Text>

<Symbol symbolId="SYMB3" type="sdlText" xCenter="187" yCenter="330" fixedDimensions="FALSE" width="264" height="572" color="#000000" fillColor="#FFFFFF">
<Description></Description>
<Text>/* Types et constantes*/

syntype PieceId = Integer
  constants 1:99
endsyntype;


NEWTYPE MachineId LITERALS
    M1, M2, M3
ENDNEWTYPE;

NEWTYPE OpCode LITERALS
    OP1, OP2, OP3
ENDNEWTYPE;

NEWTYPE Purpose LITERALS
    PLACE, DROP
ENDNEWTYPE;

NEWTYPE FailReason LITERALS
    FEED_TIMEOUT, 
    MACHINE_PICK_TIMEOUT, 
    REMOVE_TIMEOUT
ENDNEWTYPE;

NEWTYPE MachStatus LITERALS
    OK
ENDNEWTYPE;

NEWTYPE MachState LITERALS
    IDLE, 
    BUSY, 
    DOWN
ENDNEWTYPE;

SYNONYM NUM_MACHINES Integer = 3;</Text>
</Symbol>

<Symbol symbolId="SYMB6" type="sdlText" xCenter="616" yCenter="352" fixedDimensions="FALSE" width="572" height="616" color="#000000" fillColor="#FFFFFF">
<Description></Description>
<Text>/* Environnement -&gt; Superviseur */
SIGNAL NewPiece (OpCode);
SIGNAL InitPiece (PieceId,MachineId);

/* Capteurs */
SIGNAL Sensor_PlaceDone       (PieceId);
SIGNAL Sensor_MachinePickDone (MachineId, PieceId);
SIGNAL Sensor_MachineDropDone (MachineId, PieceId);
SIGNAL Sensor_RemoveDone      (PieceId);

/* Arbitrage convoyeur */
SIGNAL ReqConv     (PieceId, Purpose);
SIGNAL GrantConv   (PieceId);
SIGNAL ReleaseConv (PieceId);

/* Robot d’alimentation */
SIGNAL Cmd_Place     (PieceId, MachineId);
SIGNAL Ack_PlaceDone (PieceId);

/* Machines */
SIGNAL Cmd_Prepare      (PieceId);
SIGNAL Ack_Picked       (PieceId);
SIGNAL Rpt_EndMachining (PieceId, MachStatus);
SIGNAL Cmd_DropToConv   (PieceId);
SIGNAL Ack_Dropped      (PieceId);

/* Robot de retrait */
SIGNAL Cmd_Remove      (PieceId);
SIGNAL Ack_RemoveDone  (PieceId);

/* Supervision / sûreté */
SIGNAL Sys_Failure      (FailReason, PieceId, MachineId);
SIGNAL Cmd_StopAll;
SIGNAL Warn_MachineDown (MachineId);

/* Cycle de vie pièce (pour FIFO et libération machine côté Supervisor) */
SIGNAL Piece_Done    (PieceId, MachineId);
SIGNAL Piece_Aborted (PieceId, MachineId);
</Text>
</Symbol>

