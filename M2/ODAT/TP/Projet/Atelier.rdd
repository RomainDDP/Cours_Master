<Symbol symbolId="SYMB2" type="sdlText" xCenter="264" yCenter="165" fixedDimensions="FALSE" width="462" height="110" color="#000000" fillColor="#FFFFFF">
<Description></Description>
<Text>signal sReady;
signal sNouvelle_Piece(Code), sPiece_terminee(Code);
signal sOrdre_Depot, sDepot_Ok, sOrdre_Retrait, sRetrait_Ok;
signal sPreparer(Code), sFin_Preparation(Code);
signal sDepot_Convoyeur;
</Text>
</Symbol>

<Symbol symbolId="SYMB3" type="sdlText" xCenter="198" yCenter="363" fixedDimensions="FALSE" width="264" height="154" color="#000000" fillColor="#FFFFFF">
<Description></Description>
<Text>/* Number of machines */
Synonym NUM_MACHINE Integer = 3;

syntype Code = Integer
  default 1;
  constants 1..NUM_MACHINE;
endsyntype;
</Text>
</Symbol>
</Symbol>
