<Symbol symbolId="SYMB3" type="sdlText" xCenter="253" yCenter="165" fixedDimensions="FALSE" width="308" height="242" color="#000000" fillColor="#FFFFFF">
<Description></Description>
<Text>/* Maximum number of pLocal processes */
synonym NUM_PHONE = 5;

/* Type for a phone number */
syntype PhoneNumberType = Integer
  default = 1;
  constants 1..NUM_PHONE
endsyntype;

/* Type for the array of pLocal pids */
newtype pLocalArray
  Array(PhoneNumberType, PID)
endnewtype;
</Text>
</Symbol>

<Symbol symbolId="SYMB4" type="sdlText" xCenter="253" yCenter="473" fixedDimensions="FALSE" width="374" height="88" color="#000000" fillColor="#FFFFFF">
<Description></Description>
<Text>signal sCall(PhoneNumberType), sHangUp;
signal sReady, sCallConf, sHangUpConf, sBusy;
signal sCnxReq, sCnxConf, sDisReq, sDisConf;
signal sGetId(PhoneNumberType), sId(ID), sError;
</Text>
</Symbol>
</Symbol>
</DiagramPartition>

